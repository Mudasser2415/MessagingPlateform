{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PROD_SQL_SERVER;Database=MessagingPlatform;User Id=YOUR_PROD_USER;Password=YOUR_PROD_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_STRONG_PRODUCTION_SECRET_MIN_32_CHARS",
    "Issuer": "MessagingPlatform",
    "Audience": "MessagingPlatformUsers",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["https://yourdomain.com"]
  },
  "RabbitMq": {
    "Host": "YOUR_PROD_RABBITMQ_HOST",
    "Port": 5672,
    "Username": "YOUR_PROD_RABBITMQ_USER",
    "Password": "YOUR_PROD_RABBITMQ_PASSWORD",
    "VirtualHost": "/",
    "QueueName": "message.send",
    "ReconnectDelaySeconds": 5
  },
  "WhatsApp": {
    "BaseUrl": "https://YOUR_PROD_WHATSAPP_HOST",
    "SendEndpoint": "/send",
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
